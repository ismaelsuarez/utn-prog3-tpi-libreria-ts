# Plantilla de nginx del frontend. El punto de entrada de la imagen la procesa
# con envsubst al iniciar y deja el resultado en /etc/nginx/conf.d/default.conf.

server {
    listen 8080;
    server_name _;
    server_tokens off;
    # Toda redirección que arma nginx sale como ruta relativa al origen: detrás
    # del proxy HTTPS de la plataforma no debe aparecer http://<anfitrión>:8080.
    absolute_redirect off;

    root /usr/share/nginx/html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    include /etc/nginx/cabeceras-seguridad.conf;

    # Salud del contenedor: no consulta la API.
    location = /healthz {
        access_log off;
        default_type text/plain;
        include /etc/nginx/cabeceras-seguridad.conf;
        return 200 "ok\n";
    }

    # Entrada al login hecha por el servidor: con script-src 'self' el script en
    # línea de index.html no se ejecutaría. 302 y no 301: no se fija en caché.
    location = / {
        include /etc/nginx/cabeceras-seguridad.conf;
        return 302 /src/pages/auth/login/login.html;
    }
    location = /index.html {
        include /etc/nginx/cabeceras-seguridad.conf;
        return 302 /src/pages/auth/login/login.html;
    }

    # Recursos con huella de contenido: cacheables por un año.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/cabeceras-seguridad.conf;
        try_files $uri =404;
    }

    # Las vistas son páginas propias: sin respaldo de SPA, lo inexistente es 404.
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/cabeceras-seguridad.conf;
        try_files $uri =404;
    }
}
