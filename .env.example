# Copiar a `.env` para cambiar los valores por defecto.

# Base de la API que usa el navegador. Siempre del mismo origen (la API de
# producción no envía cabeceras CORS). Por defecto: /api
# VITE_API_BASE=/api

# Destino del reenvío de `/api` en `npm run dev` y `npm run preview`. Solo lo lee
# el servidor (sin prefijo VITE_), nunca llega al código del navegador.
# API_PROXY_TARGET=https://api.ismaelsuarez.me
